{
    "name": "@specstory/ai-data-grid-cells",
    "version": "7.0.0",
    "description": "Extra cells for ai-data-grid",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "browser": "dist/esm/index.js",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/dts/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/dts/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./dist/index.css": {
            "import": "./dist/index.css",
            "require": "./dist/index.css"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "./build.sh",
        "lint": "eslint src --ext .ts,.tsx",
        "test": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/specstoryai/ai-data-grid.git",
        "directory": "packages/cells"
    },
    "homepage": "https://github.com/specstoryai/ai-data-grid/tree/main/packages/cells",
    "author": "SpecStory",
    "bugs": {
        "url": "https://github.com/specstoryai/ai-data-grid/issues"
    },
    "license": "MIT",
    "keywords": [
        "react",
        "datagrid",
        "data-grid",
        "editor",
        "reactjs",
        "scrolling",
        "data",
        "table",
        "cell",
        "canvas"
    ],
    "dependencies": {
        "@linaria/react": "^6.3.0",
        "@milkdown/core": "~7.22.2",
        "@milkdown/plugin-history": "~7.22.2",
        "@milkdown/preset-commonmark": "~7.22.2",
        "@milkdown/preset-gfm": "~7.22.2",
        "@milkdown/prose": "~7.22.2",
        "@milkdown/utils": "~7.22.2",
        "@specstory/ai-data-grid": "7.0.0",
        "dompurify": "^3.4.16",
        "react-select": "^5.10.1"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.27.2",
        "eslint": "^8.57.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "react-resize-detector": "^12.1.0",
        "tsc-esm-fix": "^3.1.2",
        "typescript": "^5.8.3"
    }
