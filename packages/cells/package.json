{
    "name": "@specstory/ai-data-grid-cells",
    "version": "7.0.0",
    "description": "Extra cells for ai-data-grid",
    "sideEffects": [
        "**/*.css"
    ],
    "type": "module",
    "browser": "dist/esm/index.js",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/dts/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/dts/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./dist/index.css": {
            "import": "./dist/index.css",
            "require": "./dist/index.css"
        }
    },
    "files": [
        "dist",
        "!**/*.tsbuildinfo",
        "src",
        "!src/**/stories",
        "!src/**/*.stories.tsx",
        "THIRD_PARTY_NOTICES.md"
    ],
    "scripts": {
        "build": "./build.sh",
        "lint": "eslint src --ext .ts,.tsx",
        "test": "vitest"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/specstoryai/ai-data-grid.git",
        "directory": "packages/cells"
    },
    "homepage": "https://ai-data-grid-docs.vercel.app/docs",
    "author": "SpecStory",
    "bugs": {
        "url": "https://github.com/specstoryai/ai-data-grid/issues"
    },
    "license": "MIT",
    "keywords": [
        "react",
        "datagrid",
        "data-grid",
        "editor",
        "reactjs",
        "scrolling",
        "data",
        "table",
        "cell",
        "canvas"
    ],
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "dependencies": {
        "@specstory/ai-data-grid": "7.0.0",
        "@linaria/react": "^6.3.0",
        "@toast-ui/editor": "3.2.2",
        "@toast-ui/react-editor": "3.2.3",
        "react-select": "^5.10.1"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.27.2",
        "@types/prosemirror-commands": "^1.3.0",
        "eslint": "^8.57.1",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "react-resize-detector": "^12.1.0",
        "tsc-esm-fix": "^3.1.2",
        "typescript": "^5.8.3"
    }
}
