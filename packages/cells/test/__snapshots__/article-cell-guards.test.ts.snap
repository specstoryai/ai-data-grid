exports[`L: guards > L02 no node views, and the plugins that see paste, drop or DOM events (snapshot) 1`] = `
{
  "plugins": [
    {
      "key": "MILKDOWN_INLINE_NODES_CURSOR",
      "props": [
        "handleDOMEvents(beforeinput,compositionend,compositionstart)",
      ],
    },
    {
      "key": "safari-ime-span",
      "props": [
        "handleDOMEvents(compositionend,compositionstart)",
      ],
    },
    {
      "key": "selectingCells",
      "props": [
        "handleDOMEvents(mousedown)",
        "handleKeyDown",
        "handlePaste",
        "handleTripleClick",
      ],
    },
    {
      "key": "history",
      "props": [
        "handleDOMEvents(beforeinput)",
      ],
    },
    {
      "key": "ARTICLE_TASK_CHECKBOX",
      "props": [
        "handleDOMEvents(mousedown)",
      ],
    },
    {
      "key": "MILKDOWN_CUSTOM_INPUTRULES",
      "props": [
